{
    "name": "loop-monorepo",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "bun packages/cli/src/cli.ts",
        "build": "bun run gen:catalog && bun run gen:docs && bun run --filter @notshekhar/loop-sandbox build && bun run --filter @notshekhar/loop-web build && bun run --filter @notshekhar/loop-core build && bun run --filter @notshekhar/loop-tui build && bun run --filter @notshekhar/loop build",
        "gen:catalog": "bun packages/core/src/catalog/scripts/generate.ts",
        "gen:docs": "bun packages/core/src/docs/scripts/generate.ts",
        "bump": "bun scripts/bump-version.ts",
        "link": "bun run --filter @notshekhar/loop build && cd packages/cli && bun link",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "bun test"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/node": "^26.1.0",
        "prettier": "^3.9.4"
    },
    "engines": {
        "bun": ">=1.2.0"
    },
    "packageManager": "bun@1.2.0",
    "dependencies": {
        "@ai-sdk/amazon-bedrock": "^5.0.16",
        "@ai-sdk/anthropic": "^4.0.11",
        "@ai-sdk/cerebras": "^3.0.7",
        "@ai-sdk/deepseek": "^3.0.7",
        "@ai-sdk/google": "^4.0.12",
        "@ai-sdk/groq": "^4.0.7",
        "@ai-sdk/mcp": "^2.0.10",
        "@ai-sdk/mistral": "^4.0.8",
        "@ai-sdk/openai": "^4.0.11",
        "@ai-sdk/xai": "^4.0.10",
        "ai": "^7.0.20"
    }
}
